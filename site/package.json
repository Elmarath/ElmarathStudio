{
  "name": "elmarath-site",
  "private": true,
  "type": "module",
  "description": "elmarath.com as a static site: portfolio, blog and Unreal Engine plugin docs, built from ../content.",
  "scripts": {
    "media": "node scripts/media.mjs",
    "dev": "npm run media && astro dev",
    "build": "npm run media && astro build && node --experimental-strip-types --no-warnings scripts/postbuild.ts",
    "preview": "astro preview",
    "check": "astro check",
    "test": "node --experimental-strip-types --no-warnings --test \"test/**/*.test.ts\"",
    "new-post": "node scripts/new.mjs post",
    "new-doc": "node scripts/new.mjs doc",
    "new-work": "node scripts/new.mjs work"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fortawesome/free-brands-svg-icons": "^7.3.1",
    "@shikijs/rehype": "4.6.0",
    "astro": "7.4.5",
    "hast-util-to-string": "3.0.1",
    "lucide-static": "^1.68.0",
    "mermaid": "12.3.0",
    "rehype-raw": "7.0.0",
    "rehype-stringify": "10.0.1",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "sharp": "0.35.5",
    "shiki": "4.6.0",
    "unified": "11.0.5",
    "unist-util-visit": "5.2.0",
    "yaml": "2.9.1"
  }
}
