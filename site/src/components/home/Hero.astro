---
// The top of the home page. A full-width statement, then the showreel framed
// like an editor viewport (with the clip that's playing named under it), and
// what you do and the two main links beside it (below it, on
// smaller screens). A faint engine grid sits behind it all.
//
// The glow around the showreel is baked by scripts/media.mjs per clip and
// theme, and cross-fades when the clip changes. The video, the glow and the
// grid are drawn by the browser's compositor, so the page never repaints for
// them, even while scrolling.
import { site } from '../../config.ts';
import { humanize } from '../../content/text.ts';
// @ts-expect-error: plain JavaScript module shared with the media script.
import { GLOW_VERSION, pub } from '../../../scripts/media-lib.mjs';
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import Icon from '../Icon.astro';

const clips = site.heroVideos.map((entry) => {
  const { src, label } = typeof entry === 'string' ? { src: entry, label: undefined } : entry;
  const base = src.replace(/\.\w+$/, '');
  const name = base.split('/').at(-1)!;
  const glow = (bright: boolean) => `/media/glow/${name}.glow-${GLOW_VERSION}-video${bright ? '-bright' : ''}.webp`;
  // The smaller AV1 copy made by `npm run video`, when there is one.
  const av1 = existsSync(join(pub, `${base}.av1.mp4`)) ? `${base}.av1.mp4` : undefined;
  return { src, av1, poster: `${base}.jpg`, label: label ?? humanize(name), glow };
});
const AV1_TYPE = 'video/mp4; codecs="av01.0.08M.08"';
const [title1, title2] = site.heroTitle.split('\n');
---

<section class="hero">
  <div class="grid-bg" aria-hidden="true"></div>
  <div class="container inner">
    <header class="head">
      <div class="who">
        <a class="owner" href="/about">
          <img src={site.avatarUrl} alt="" width="28" height="28" />
          <span class="name">{site.ownerName}</span>
          <span class="role">{site.role}</span>
          <Icon name="arrow-right" />
        </a>
        <a class="cv" href="/cv"><Icon name="doc" />CV</a>
      </div>
      <h1 class="title">{title1}<br /><span class="accent">{title2}</span></h1>
    </header>

    <div class="side">
      <p class="subtitle">
        {site.heroSubtitle.split('\n').map((line, i) => (i === 0 ? line : [<br />, line]))}
      </p>
      <div class="button-row">
        <a class="button button-filled" href="/work"><Icon name="work" />See my work</a>
        <a class="button button-outlined" href="/docs"><Icon name="book" />Plugin docs</a>
        <a class="button button-outlined" href="#contact"><Icon name="mail" />Contact</a>
      </div>
    </div>

    <div class="reel" data-showreel data-clips={JSON.stringify(clips.map((c) => c.src))} data-av1={JSON.stringify(clips.map((c) => c.av1 ?? null))} data-labels={JSON.stringify(clips.map((c) => c.label))}>
      <div class="glow" aria-hidden="true">
        {
          clips.map((c, i) =>
            [false, true].map((bright) => (
              <img class:list={[bright ? 'bright' : 'dark', { on: i === 0 }]} src={c.glow(bright)} alt="" decoding="async" />
            )),
          )
        }
      </div>
      <figure class="viewport">
        <div class="screen">
          <video muted playsinline preload="metadata" poster={clips[0].poster} aria-hidden="true" tabindex="-1">
            {clips[0].av1 && <source src={clips[0].av1} type={AV1_TYPE} />}
            <source src={clips[0].src} type="video/mp4" />
          </video>
        </div>
        <span class="corner tl" aria-hidden="true"></span>
        <span class="corner tr" aria-hidden="true"></span>
        <span class="corner bl" aria-hidden="true"></span>
        <span class="corner br" aria-hidden="true"></span>
        <figcaption class="hud">
          <span class="live" aria-hidden="true"></span>
          <span class="now">Now playing</span>
          <span class="clip" data-clip-label>{clips[0].label}</span>
        </figcaption>
      </figure>
    </div>
  </div>
</section>

<script>
  import { onPage } from '../../scripts/lifecycle.ts';
  import { startShowreel } from '../../scripts/showreel.ts';
  onPage(startShowreel);
</script>

<style>
  .hero { position: relative; isolation: isolate; padding-block: 40px 32px; }
  @media (min-width: 720px) { .hero { padding-block: 72px 48px; } }

  /* The engine grid: faint lines that fade out from the top of the page. */
  .grid-bg {
    position: absolute;
    inset: 0;
    z-index: -2;
    background-image:
      linear-gradient(var(--grid-line) 1px, transparent 1px),
      linear-gradient(90deg, var(--grid-line) 1px, transparent 1px);
    background-size: 56px 56px;
    background-position: center top;
    mask-image: radial-gradient(ellipse 75% 70% at 50% 20%, #000 35%, transparent 80%);
    pointer-events: none;
  }

  /* Phones and tablets: statement, text, then the showreel. Wide screens: the
     statement across the top, the showreel and the text side by side under it. */
  .inner {
    display: grid;
    grid-template-areas: 'head' 'side' 'reel';
    row-gap: clamp(28px, 5vw, 48px);
  }
  @media (min-width: 1100px) {
    .inner {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      grid-template-areas: 'head head' 'reel side';
      column-gap: 56px;
      row-gap: 48px;
      align-items: center;
    }
  }
  .head { grid-area: head; display: grid; justify-items: start; }
  .side { grid-area: side; display: grid; justify-items: start; position: relative; z-index: 1; }
  .reel { grid-area: reel; }

  /* Each part comes in, one after another (transform and opacity only). */
  .head > *, .side > *, .reel { animation: rise 520ms var(--ease) both; }
  .head > :nth-child(2) { animation-delay: 60ms; }
  .side > :nth-child(1) { animation-delay: 140ms; }
  .side > :nth-child(2) { animation-delay: 200ms; }
  .reel { animation-delay: 160ms; }
  @keyframes rise { from { opacity: 0; transform: translateY(14px); } }

  /* Who you are, and the CV one click away (it opens in a window; /cv without scripts). */
  .who { display: flex; align-items: stretch; gap: 8px; max-width: 100%; min-width: 0; }
  .cv {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    flex: none;
    padding: 0 14px 0 11px;
    border: 1px solid color-mix(in srgb, var(--accent) 55%, transparent);
    border-radius: var(--r-sm);
    background: var(--accent-soft);
    color: var(--accent);
    font-size: 13.5px;
    font-weight: 650;
    transition: background-color var(--fast), color var(--fast), border-color var(--fast);
  }
  .cv:hover { background: var(--accent); border-color: var(--accent); color: var(--on-accent); }
  .cv :global(.icon) { font-size: 15px; }
  .owner {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-width: 0;
    padding: 4px 12px 4px 4px;
    border: 1px solid var(--border);
    border-radius: var(--r-sm);
    background: color-mix(in srgb, var(--surface) 80%, transparent);
    font-size: 13.5px;
    transition: border-color var(--fast);
  }
  .owner:hover { border-color: color-mix(in srgb, var(--accent) 60%, transparent); }
  .owner img { width: 28px; height: 28px; border-radius: 3px; }
  .owner .name { font-weight: 600; color: var(--text); white-space: nowrap; }
  .owner .role {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    padding-left: 10px;
    border-left: 1px solid var(--border);
    font-family: var(--mono);
    font-size: 12px;
    letter-spacing: 0.02em;
    color: var(--text-3);
  }
  .owner :global(.icon) { flex: none; color: var(--accent); font-size: 15px; transition: transform var(--fast); }
  .owner:hover :global(.icon) { transform: translateX(3px); }

  .title {
    margin-top: clamp(20px, 3vw, 32px);
    font-size: clamp(36px, 6.2vw, 58px);
    font-weight: 700;
    letter-spacing: -0.035em;
    line-height: 1.02;
  }
  @media (min-width: 1100px) { .title { font-size: clamp(60px, 5.6vw, 82px); } }
  .accent { color: var(--accent); }

  .subtitle { max-width: 560px; font-size: clamp(15.5px, 1.9vw, 17.5px); line-height: 1.65; color: var(--text-2); }
  .side .button-row { margin-top: 28px; gap: 12px; }
  @media (max-width: 479px) {
    .side .button-row { display: grid; grid-template-columns: 1fr 1fr; width: 100%; }
    .side .button-row .button { padding: 0 12px; }
    .side .button-row .button:first-child { grid-column: 1 / -1; }
  }

  /* The showreel, framed like an editor viewport. The frame is black, so
     between clips the video dips to black rather than showing the glow. */
  .reel { position: relative; }
  .viewport { position: relative; margin: 0; }
  .screen {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border: 1px solid var(--border-strong);
    border-radius: var(--r-md);
    background: #000;
  }
  video { display: block; width: 100%; height: 100%; object-fit: cover; transition: opacity 350ms ease; }
  video.swapping { opacity: 0; }
  .corner { position: absolute; width: 14px; height: 14px; border: 0 solid var(--accent); pointer-events: none; }
  .corner.tl { top: -6px; left: -6px; border-top-width: 2px; border-left-width: 2px; }
  .corner.tr { top: -6px; right: -6px; border-top-width: 2px; border-right-width: 2px; }
  .corner.bl { bottom: 30px; left: -6px; border-bottom-width: 2px; border-left-width: 2px; }
  .corner.br { bottom: 30px; right: -6px; border-bottom-width: 2px; border-right-width: 2px; }
  .hud {
    display: flex;
    align-items: center;
    gap: 10px;
    height: 36px;
    padding-top: 12px;
    font-family: var(--mono);
    font-size: 11.5px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-3);
  }
  .live { flex: none; width: 7px; height: 7px; border-radius: 50%; background: var(--accent); box-shadow: 0 0 0 3px var(--accent-soft); }
  .clip { color: var(--text); font-weight: 600; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

  /* The glow: the clip's colours spreading past the frame and fading out
     (GLOW_SPREAD in scripts/media.mjs), 70% of that on phones. */
  .glow { position: absolute; z-index: -1; inset: -300px -300px -264px; pointer-events: none; }
  @media (max-width: 719px) { .glow { transform: scale(0.7); } }
  .glow img { position: absolute; inset: 0; width: 100%; height: 100%; opacity: 0; transition: opacity 700ms ease; }
  .glow .dark.on { opacity: calc(var(--glow-dark) * 0.85); }
  .glow .bright.on { opacity: var(--glow-bright); }
</style>
