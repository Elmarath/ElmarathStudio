---
// Work on the home page, like the blog's latest posts: the first few entries
// (lowest `order:`) as cards, two to a row on wide screens.
import { content } from '../../content/repository.ts';
import SectionHeader from '../SectionHeader.astro';
import WorkCard from '../work/WorkCard.astro';

interface Props {
  count?: number;
}
const { count = 4 } = Astro.props;
const work = content().work.slice(0, count);
---

{
  work.length > 0 && (
    <section class="container section">
      <SectionHeader eyebrow="Work" title="What I've built" actionLabel="All work" actionHref="/work" count={content().work.length} />
      <div class="grid" style="--min: 420px; --grid-gap: 20px">
        {work.map((s) => <WorkCard study={s} />)}
      </div>
    </section>
  )
}
