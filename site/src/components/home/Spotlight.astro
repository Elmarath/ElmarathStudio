---
// Epic Games Store–style featured carousel: a big banner that moves on every
// 7 seconds, with every plugin in a list beside it (a row below it on smaller
// screens). Plugins with `featured: true` come first. It plays until the pause
// button in the banner's corner is pressed.
//
// The slides are a native scroll-snap row: on touch screens a swipe is the
// browser's own scrolling. The script only runs the timer and the buttons, and
// only while the carousel is on screen.
import { content, pitch } from '../../content/repository.ts';
import { blurredThumbnail, image } from '../../content/media.ts';
import Icon from '../Icon.astro';
import SectionHeader from '../SectionHeader.astro';

const items = await Promise.all(
  content().spotlightPlugins.map(async (plugin) => ({
    plugin,
    pitch: pitch(plugin),
    art: plugin.thumbnail ? await image(plugin.thumbnail, 280) : null,
    tab: plugin.thumbnail ? await image(plugin.thumbnail, 48) : null,
    background: plugin.thumbnail ? blurredThumbnail(plugin.thumbnail) : null,
  })),
);
---

{
  items.length > 0 && (
    <section class="container section spotlight" data-carousel>
      <SectionHeader eyebrow="Featured" title="Unreal Engine plugins" actionLabel="All plugins" actionHref="/docs" />
      <div class="carousel">
        <div class="banner">
          <div class="slides" tabindex="-1">
            {items.map(({ plugin, pitch, art, background }, i) => (
              <article class="slide" aria-roledescription="slide" aria-label={`${i + 1} of ${items.length}: ${plugin.label}`}>
                {background && <img class="backdrop" src={background} alt="" loading={i === 0 ? 'eager' : 'lazy'} decoding="async" />}
                <div class="content">
                  <div class="details">
                    <span class="eyebrow">Unreal Engine plugin</span>
                    <h3 class="name">{plugin.label}</h3>
                    <p class="pitch">{pitch}</p>
                    <div class="button-row">
                      <a class="button button-filled" href={plugin.route}>Read the docs</a>
                      {plugin.links.fab && (
                        <a class="button button-outlined light" href={plugin.links.fab} target="_blank" rel="noopener">
                          <Icon name="store" />
                          View on Fab
                        </a>
                      )}
                    </div>
                  </div>
                  {art && (
                    <img class="art" src={art.src} srcset={art.srcset} sizes="(max-width: 719px) 120px, 280px" width="280" height="280" alt="" loading={i === 0 ? 'eager' : 'lazy'} decoding="async" />
                  )}
                </div>
              </article>
            ))}
          </div>
          <button type="button" class="pause" data-pause aria-label="Pause" title="Pause">
            <span class="when-playing"><Icon name="pause" /></span>
            <span class="when-paused"><Icon name="play" /></span>
          </button>
        </div>
        <div class="tabs" role="tablist" aria-label="Plugins">
          {items.map(({ plugin, tab }, i) => (
            <button type="button" class="tab" role="tab" aria-selected={i === 0 ? 'true' : 'false'} data-index={i} title={plugin.label}>
              {tab ? <img src={tab.src} alt="" width="48" height="48" loading="lazy" decoding="async" /> : <span class="blank" />}
              <span class="label">{plugin.label}</span>
            </button>
          ))}
        </div>
      </div>
    </section>
  )
}

<script>
  import { startCarousels } from '../../scripts/carousel.ts';
  startCarousels();
</script>

<style>
  .carousel { display: grid; gap: 8px; }
  @media (min-width: 1100px) {
    .carousel { grid-template-columns: 1fr 290px; gap: 16px; height: 440px; }
  }

  .banner { position: relative; height: 560px; border-radius: var(--r-lg); overflow: hidden; background: #0b0b0e; isolation: isolate; }
  @media (min-width: 720px) { .banner { height: 480px; } }
  @media (min-width: 1100px) { .banner { height: 100%; } }

  .slides {
    display: flex;
    height: 100%;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    overscroll-behavior-x: contain;
  }
  .slides::-webkit-scrollbar { display: none; }
  /* On wide screens the banner moves only with the list and the timer, as on Fab. */
  @media (min-width: 1100px) { .slides { overflow-x: hidden; } }
  .slide { position: relative; flex: 0 0 100%; height: 100%; scroll-snap-align: start; scroll-snap-stop: always; overflow: hidden; }
  .backdrop { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transform: scale(1.1); }
  .slide::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgb(0 0 0 / 0.82), rgb(0 0 0 / 0.35));
  }
  @media (min-width: 720px) {
    .slide::after { background: linear-gradient(to right, rgb(0 0 0 / 0.82), rgb(0 0 0 / 0.35)); }
  }
  .content {
    position: relative;
    z-index: 1;
    display: flex;
    /* Phones: the art above the text, both at the bottom of the banner. */
    flex-direction: column-reverse;
    justify-content: flex-start;
    gap: 24px;
    height: 100%;
    padding: 24px;
  }
  @media (min-width: 720px) {
    .content { flex-direction: row; align-items: center; gap: 32px; padding: 48px; }
  }
  .details { display: grid; justify-items: start; gap: 8px; flex: 1; min-width: 0; }
  .details .eyebrow { color: rgb(255 255 255 / 0.7); }
  .name { color: #fff; font-size: 32px; letter-spacing: -0.5px; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  @media (min-width: 720px) { .name { font-size: 38px; letter-spacing: -1px; } }
  .pitch { margin-top: 8px; color: rgb(255 255 255 / 0.8); display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .details .button-row { margin-top: 16px; }
  .details .button { min-height: 40px; min-width: 168px; }
  .button.light { color: #fff; border-color: rgb(255 255 255 / 0.54); }
  .button.light:hover { border-color: #fff; background: rgb(255 255 255 / 0.08); }
  .art {
    width: 120px;
    height: 120px;
    flex: none;
    border-radius: var(--r-lg);
    box-shadow: 0 20px 40px rgb(0 0 0 / 0.54);
    object-fit: cover;
    align-self: flex-start;
  }
  @media (min-width: 720px) { .art { width: 280px; height: 280px; align-self: center; } }
  @media (min-width: 720px) and (max-width: 1099px) { .art { width: 200px; height: 200px; } }

  .pause {
    position: absolute;
    right: 16px;
    bottom: 16px;
    z-index: 2;
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    border: 1px solid rgb(255 255 255 / 0.24);
    background: rgb(0 0 0 / 0.45);
    color: #fff;
    font-size: 18px;
    transition: background-color var(--fast);
  }
  .pause:hover { background: rgb(255 255 255 / 0.12); }
  .pause :global(.icon) { fill: currentColor; stroke: none; }
  .when-paused, [data-paused] .when-playing { display: none; }
  [data-paused] .when-paused { display: contents; }
  .when-playing { display: contents; }

  /* The list of plugins: a column beside the banner, a scrolling row below it. */
  .tabs {
    display: flex;
    gap: 8px;
    height: 72px;
    overflow-x: auto;
    scrollbar-width: none;
    overscroll-behavior-x: contain;
    scroll-snap-type: x proximity;
  }
  .tabs::-webkit-scrollbar { display: none; }
  .tab {
    display: flex;
    align-items: center;
    gap: 14px;
    flex: 0 0 auto;
    width: min(240px, 60vw);
    height: 100%;
    padding: 0 12px;
    border: 0;
    border-radius: var(--r-md);
    background: none;
    text-align: left;
    scroll-snap-align: start;
    transition: background-color var(--fast);
  }
  .tab:hover { background: color-mix(in srgb, var(--surface) 60%, transparent); }
  .tab[aria-selected='true'] { background: var(--surface); }
  .tab img, .blank { width: 48px; height: 48px; flex: none; border-radius: var(--r-sm); object-fit: cover; }
  .label { font-size: 14px; font-weight: 600; color: var(--text-2); display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .tab[aria-selected='true'] .label { color: var(--text); }
  @media (min-width: 1100px) {
    .tabs { flex-direction: column; height: auto; gap: 4px; overflow-x: hidden; overflow-y: auto; scroll-snap-type: y proximity; }
    .tab { width: 100%; height: auto; min-height: 72px; flex: 1 0 72px; max-height: 112px; }
  }
</style>
