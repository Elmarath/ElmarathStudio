---
// A blog post preview in the style of the Unreal Engine feed: an inset cover
// with badges, then the date, title and excerpt.
import { formatDate, type BlogPost } from '../../content/repository.ts';
import PostCover from './PostCover.astro';
import PostBadges from './PostBadges.astro';

interface Props {
  post: BlogPost;
  eager?: boolean;
}
const { post, eager = false } = Astro.props;
---

<a class="card post-card" href={post.route}>
  <div class="cover zoom-media">
    <PostCover post={post} width={400} eager={eager} />
    <PostBadges post={post} />
  </div>
  <time class="body-md date" datetime={post.date.toISOString().slice(0, 10)}>{formatDate(post.date)}</time>
  <h3 class="title">{post.title}</h3>
  <p class="excerpt body-md">{post.excerpt}</p>
</a>

<style>
  /* The cover runs edge to edge across the top; the text sits below it. */
  .post-card { display: flex; flex-direction: column; overflow: hidden; border-radius: var(--r-lg); }
  .cover { position: relative; aspect-ratio: 16 / 9; border-bottom: 1px solid var(--border); }
  .cover :global(.badges) { position: absolute; left: 12px; right: 12px; bottom: 12px; }
  .date, .title, .excerpt { margin-inline: 20px; }
  .date { display: block; margin-top: 18px; font-family: var(--mono); font-size: 12px; letter-spacing: 0.04em; text-transform: uppercase; color: var(--text-3); }
  .excerpt { margin-bottom: 22px; }
  .title { margin-top: 8px; font-family: var(--display); font-size: 19px; font-weight: 700; letter-spacing: -0.01em; line-height: 1.3; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .excerpt { margin-top: 8px; line-height: 1.7; display: -webkit-box; -webkit-line-clamp: 4; -webkit-box-orient: vertical; overflow: hidden; }
</style>
