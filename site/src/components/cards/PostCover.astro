---
// A post's looping clip or cover image, or a branded gradient with the logo when it has none.
import { site } from '../../config.ts';
import { image } from '../../content/media.ts';
import { loopVideo, loopVideoHtml } from '../../content/video.ts';
import type { BlogPost } from '../../content/repository.ts';

interface Props {
  post: BlogPost;
  /** The widest it's shown, in CSS pixels. */
  width?: number;
  eager?: boolean;
}
const { post, width = 400, eager = false } = Astro.props;
const video = post.video ? await loopVideo(post.video, width) : null;
const info = !video && post.image ? await image(post.image, width) : null;
---

{
  video ? (
    <Fragment set:html={loopVideoHtml(video, { className: 'post-cover' })} />
  ) : info ? (
    <img
      class="post-cover"
      src={info.src}
      srcset={info.srcset}
      sizes={`(max-width: 719px) 100vw, ${width}px`}
      width={info.width}
      height={info.height}
      alt=""
      loading={eager ? 'eager' : 'lazy'}
      decoding="async"
      fetchpriority={eager ? 'high' : undefined}
    />
  ) : (
    <div class="post-cover placeholder">
      <img src={site.logo} alt="" width="120" height="120" loading="lazy" />
    </div>
  )
}

<style>
  .post-cover, :global(video.post-cover) { width: 100%; height: 100%; object-fit: cover; }
  .placeholder { display: grid; place-items: center; background: radial-gradient(140% 140% at 20% 10%, var(--hero-glow), #0b0b0e); }
  /* 36% of the cover's height (a 16:9 cover is 0.5625 as tall as wide). */
  .placeholder img { width: 20%; height: auto; opacity: 0.9; }
</style>
