---
// "Was this useful?" at the end of a blog post or a docs page. It's a Netlify form: Netlify
// finds it in the built page and keeps what's sent (site → Forms in the
// Netlify dashboard), so there's no server of our own. A thumb picks the rating
// (it can be changed until it's sent) and opens an optional comment; Send makes
// one entry with both. A rating left unsent goes on its own when the reader
// leaves the page. Nobody signs in and nothing personal is asked. It needs
// scripts: the thumbs fill in the rating field.
import Icon from './Icon.astro';

interface Props {
  /** The Netlify form it goes to: posts and docs are kept apart in the dashboard. */
  form: 'post-feedback' | 'docs-feedback';
  /** The page's path, e.g. /blog/crafting-in-the-freeblades. */
  page: string;
  title: string;
  question: string;
}
const { form, page, title, question } = Astro.props;
---

<form class="feedback" name={form} method="POST" data-netlify="true" netlify-honeypot="company" data-feedback>
  <input type="hidden" name="form-name" value={form} />
  <input type="hidden" name="page" value={page} />
  <input type="hidden" name="title" value={title} />
  {/* Netlify keeps only the fields it finds as inputs here, not button values: the rating goes in this one. */}
  <input type="hidden" name="rating" value="" />
  <p class="trap" aria-hidden="true">
    <label>Leave this empty <input name="company" tabindex="-1" autocomplete="off" /></label>
  </p>

  <div class="ask" data-ask>
    <p class="question">{question}</p>
    <div class="thumbs">
      <button type="button" class="button button-outlined" data-rating value="up" aria-pressed="false"><Icon name="thumbs-up" />Yes</button>
      <button type="button" class="button button-outlined" data-rating value="down" aria-pressed="false"><Icon name="thumbs-down" />Not really</button>
    </div>
  </div>

  <div class="more" data-more hidden>
    <p class="question">Anything you'd add? <span>(optional)</span></p>
    <textarea name="comment" rows="3" maxlength="2000" placeholder="What worked, what was missing, what you'd like to see next…"></textarea>
    <button type="submit" class="button button-filled" data-send><Icon name="send" />Send</button>
  </div>

  <p class="done" data-done hidden>Thanks, that helps.</p>
  <p class="error" data-error hidden>That didn't go through. Please try again in a moment.</p>
</form>

<style>
  .feedback { display: grid; gap: 14px; margin: 8px 0 32px; padding: 20px 22px; border: 1px solid var(--border); border-radius: var(--r-lg); background: var(--surface); }
  .ask { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px 20px; }
  .question { font-weight: 600; color: var(--text); }
  .question span { font-weight: 400; color: var(--text-3); }
  .thumbs { display: flex; gap: 10px; }
  .thumbs .button[aria-pressed='true'] { border-color: var(--accent); color: var(--accent); }
  .more { display: grid; gap: 12px; }
  .ask[hidden], .more[hidden], .done[hidden], .error[hidden] { display: none; }
  textarea { width: 100%; padding: 12px 14px; border: 1px solid var(--border-strong); border-radius: var(--r-md); background: var(--bg); color: var(--text); font: inherit; font-size: 15px; resize: vertical; }
  textarea:focus { outline: 2px solid var(--accent); outline-offset: 1px; }
  .more .button { justify-self: start; }
  .done { color: var(--accent); font-weight: 600; }
  .error { color: var(--danger, #e5484d); font-size: 14px; }
  .trap { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
</style>
