---
// The CV in a window over the page. Links to `site.resumeUrl` open it; without
// scripts they go to the /cv page instead. The PDF loads only when opened.
import { site } from '../config.ts';
import Icon from './Icon.astro';
---

<dialog id="cv" class="cv" aria-label="Curriculum Vitae">
  <div class="bar">
    <div>
      <p class="title-md">Curriculum Vitae</p>
      <p class="body-sm">{site.ownerName}</p>
    </div>
    <span class="spacer"></span>
    <a class="button button-outlined" href={site.cvFile} download><Icon name="download" /><span>Download</span></a>
    <form method="dialog"><button class="icon-button" aria-label="Close"><Icon name="close" /></button></form>
  </div>
  <iframe title="Curriculum Vitae" data-src={`${site.cvFile}#view=FitH`}></iframe>
  <p class="fallback body-md">
    Can't see it? <a href={site.cvFile} target="_blank" rel="noopener">Open the PDF</a>.
  </p>
</dialog>

<style>
  .cv { width: min(1000px, 100vw - 32px); height: min(92dvh, 1200px); flex-direction: column; overflow: hidden; }
  .cv[open] { display: flex; }
  .bar { display: flex; align-items: center; gap: 8px; padding: 10px 10px 10px 20px; border-bottom: 1px solid var(--border); }
  .spacer { flex: 1; }
  .bar .button { min-height: 38px; padding: 0 14px; }
  iframe { flex: 1; width: 100%; border: 0; background: #525659; }
  .fallback { padding: 8px 20px; border-top: 1px solid var(--border); }
  .fallback a { color: var(--accent); text-decoration: underline; }
  @media (max-width: 719px) {
    .cv { width: 100vw; max-width: 100vw; height: 100dvh; max-height: 100dvh; border-radius: 0; border: 0; }
    .bar .button span { display: none; }
  }
</style>
