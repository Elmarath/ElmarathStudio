---
// Heading for a page section, with an optional "View all" link on the right.
import Icon from './Icon.astro';

interface Props {
  title: string;
  eyebrow?: string;
  actionLabel?: string;
  actionHref?: string;
}
const { title, eyebrow, actionLabel, actionHref } = Astro.props;
---

<div class="section-header">
  <div>
    {eyebrow && <span class="eyebrow">{eyebrow}</span>}
    <h2 class="headline-lg">{title}</h2>
  </div>
  {
    actionLabel && actionHref && (
      <a class="action" href={actionHref}>
        {actionLabel}
        <Icon name="arrow-right" />
      </a>
    )
  }
</div>

<style>
  .section-header { display: flex; align-items: flex-end; justify-content: space-between; gap: 16px; margin-bottom: 24px; }
  .section-header > div { display: grid; gap: 8px; }
  .action { display: inline-flex; align-items: center; gap: 6px; flex: none; color: var(--accent); font-size: 14px; font-weight: 600; }
  .action :global(.icon) { transition: transform var(--fast); }
  .action:hover :global(.icon) { transform: translateX(3px); }
</style>
