---
interface Props {
  tech: string[];
  dense?: boolean;
}
const { tech, dense = false } = Astro.props;
---

<ul class:list={['tech', { dense }]}>{tech.map((t) => <li>{t}</li>)}</ul>

<style>
  .tech { display: flex; flex-wrap: wrap; gap: 6px; margin: 0; padding: 0; list-style: none; }
  li { padding: 6px 12px; border: 1px solid var(--border); border-radius: 99px; background: var(--surface-raised); color: var(--text-2); font-size: 12.5px; font-weight: 600; letter-spacing: 0.2px; line-height: 1.2; }
  .dense li { padding: 3px 8px; font-size: 11px; }
</style>
