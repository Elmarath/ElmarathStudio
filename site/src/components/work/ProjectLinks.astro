---
// A case study's buttons (reel, repository, store, docs...), the first one filled.
import type { IconName } from '../../config.ts';
import { isExternal } from '../../content/text.ts';
import Icon from '../Icon.astro';

interface Props {
  links: Record<string, string>;
}
const { links } = Astro.props;
const look = (key: string): [IconName, string] => {
  switch (key.toLowerCase()) {
    case 'reel': case 'youtube': case 'video': return ['youtube', 'Watch the reel'];
    case 'github': case 'repo': case 'repository': return ['github', 'Repository'];
    case 'fab': return ['store', 'Get it on Fab'];
    case 'steam': return ['gamepad', 'Steam page'];
    case 'itch': return ['gamepad', 'Play on itch.io'];
    case 'docs': return ['book', 'Documentation'];
    case 'website': case 'site': return ['globe', 'Website'];
    default: return ['external', key[0].toUpperCase() + key.slice(1)];
  }
};
---

<div class="button-row">
  {
    Object.entries(links).map(([key, url], i) => {
      const [icon, label] = look(key);
      return (
        <a class:list={['button', i === 0 ? 'button-filled' : 'button-outlined']} href={url} {...(isExternal(url) ? { target: '_blank', rel: 'noopener' } : {})}>
          <Icon name={icon} />
          {label}
        </a>
      );
    })
  }
</div>
