---
// A Work entry's buttons (reel, repository, store, docs...), the first one filled.
import { linkLook } from '../../content/work-links.ts';
import { isExternal } from '../../content/text.ts';
import Icon from '../Icon.astro';

interface Props {
  links: Record<string, string>;
}
const { links } = Astro.props;
---

<div class="button-row">
  {
    Object.entries(links).map(([key, url], i) => {
      const [icon, label] = linkLook(key);
      return (
        <a class:list={['button', i === 0 ? 'button-filled' : 'button-outlined']} href={url} {...(isExternal(url) ? { target: '_blank', rel: 'noopener' } : {})}>
          <Icon name={icon} />
          {label}
        </a>
      );
    })
  }
</div>
