---
// A Work entry as a card: its picture or clip, when and where, the name with
// your role beside it (in gold: what a hiring team looks for first), the 50 to
// 100 word summary, the main tech, and two ways on: the entry's page and its
// one main link. The whole card opens the page; the main link sits above that.
//
// `layout="row"` puts the picture beside the text (wide screens), for lists.
import type { CaseStudy } from '../../content/repository.ts';
import { mainLink } from '../../content/work-links.ts';
import Icon from '../Icon.astro';
import TechTags from './TechTags.astro';
import WorkMedia from './WorkMedia.astro';

interface Props {
  study: CaseStudy;
  layout?: 'stack' | 'row';
  headingLevel?: 'h2' | 'h3';
}
const { study, layout = 'stack', headingLevel: H = 'h3' } = Astro.props;
const link = mainLink(study);
// Who it was for (when the entry is named after the project), where, and when.
const meta = [study.company !== study.title ? study.company : undefined, study.location, study.period].filter(Boolean).join('  ·  ');
// "Solo developer: C++, Blueprint API and documentation" → "Solo developer" on the
// card (the whole of it on the entry's page).
const role = study.role?.split(/:\s*/)[0];
---

<article class:list={['card interactive work-card', layout]}>
  <div class="media zoom-media">
    <WorkMedia study={study} width={layout === 'row' ? 620 : 600} />
    <div class="badges">
      <span class="badge">{study.workKind}</span>
      {study.draft && <span class="badge"><Icon name="edit" />Draft</span>}
    </div>
  </div>
  <div class="body">
    {meta && <p class="meta">{meta}</p>}
    <div class="heading">
      <H class="title"><a class="open" href={study.route}>{study.title}</a></H>
      {role && <p class="role" title={study.role}><Icon name="work" /><span class="visually-hidden">Role: </span>{role}</p>}
    </div>
    {study.summary && <p class="summary">{study.summary}</p>}
    {study.tech.length > 0 && <TechTags tech={study.tech.slice(0, 5)} dense />}
    <div class="foot">
      <span class="more">View project<Icon name="arrow-right" /></span>
      {
        link && (
          <a class="main-link" href={link.url} {...(link.external ? { target: '_blank', rel: 'noopener' } : {})}>
            <Icon name={link.icon} />
            {link.label}
          </a>
        )
      }
    </div>
  </div>
</article>

<style>
  .work-card { display: flex; flex-direction: column; overflow: hidden; border-radius: var(--r-lg); }
  .media { position: relative; aspect-ratio: 16 / 9; border-bottom: 1px solid var(--border); background: var(--surface-raised); }
  .badges { position: absolute; left: 12px; bottom: 12px; display: flex; gap: 6px; }
  .body { display: flex; flex-direction: column; gap: 10px; flex: 1; padding: 20px 22px 18px; }
  .meta { font-family: var(--mono); font-size: 12px; letter-spacing: 0.04em; text-transform: uppercase; color: var(--text-3); }
  .title { font-family: var(--display); font-size: 22px; font-weight: 700; letter-spacing: -0.015em; line-height: 1.2; }
  /* The whole card opens the entry's page. */
  .open::after { content: ''; position: absolute; inset: 0; z-index: 0; }
  /* The name and the role share a line; the role drops below only when there isn't room. */
  .heading { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 12px; }
  .role {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 4px 10px 4px 8px;
    border: 1px solid color-mix(in srgb, var(--accent) 35%, transparent);
    border-radius: var(--r-sm);
    background: var(--accent-soft);
    color: var(--accent);
    font-size: 13.5px;
    font-weight: 650;
    line-height: 1.3;
    white-space: nowrap;
  }
  .role :global(.icon) { flex: none; font-size: 14px; }
  .summary { font-size: 14.5px; line-height: 1.7; }
  .foot { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-top: auto; padding-top: 14px; border-top: 1px solid var(--border); }
  .more { display: inline-flex; align-items: center; gap: 6px; font-size: 13.5px; font-weight: 600; color: var(--accent); }
  .more :global(.icon) { transition: transform var(--fast); }
  .work-card:hover .more :global(.icon) { transform: translateX(3px); }
  .main-link {
    position: relative;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    min-height: 34px;
    padding: 0 12px;
    border: 1px solid var(--border-strong);
    border-radius: var(--r-sm);
    font-size: 13px;
    font-weight: 600;
    color: var(--text);
    transition: border-color var(--fast), color var(--fast);
  }
  .main-link:hover { border-color: var(--accent); color: var(--accent); }
  .main-link :global(.icon) { font-size: 15px; }

  @media (min-width: 900px) {
    .row { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); }
    .row .media { aspect-ratio: auto; min-height: 100%; border-bottom: 0; border-right: 1px solid var(--border); }
    .row .media > :global(*:first-child) { position: absolute; inset: 0; }
    .row .body { padding: 28px 32px 24px; gap: 12px; }
    .row .title { font-size: 28px; }
    .row .role { font-size: 14.5px; }
    .row .summary { font-size: 15.5px; }
  }
</style>
