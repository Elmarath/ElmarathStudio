---
// Impact numbers ("6 / plugins on Fab"), read at a glance: the first thing a
// hiring team scans for.
import type { WorkStat } from '../../../content/repository.ts';

interface Props {
  stats: WorkStat[];
}
const { stats } = Astro.props;
---

<dl class="stats" style={`--n: ${Math.min(stats.length, 4)}`}>
  {
    stats.map((s) => (
      <div>
        <dt>{s.label}</dt>
        <dd>{s.value}</dd>
      </div>
    ))
  }
</dl>

<style>
  /* Always one row: on narrow screens the numbers and padding shrink with the row's width. */
  .stats {
    container-type: inline-size;
    display: grid;
    grid-template-columns: repeat(var(--n), minmax(0, 1fr));
    margin: 0;
    border: 1px solid var(--border);
    border-radius: var(--r-lg);
    background: var(--surface);
    overflow: hidden;
  }
  .stats div { display: flex; flex-direction: column-reverse; justify-content: flex-end; gap: 6px; padding: clamp(14px, 5cqi, 22px) clamp(10px, 4cqi, 24px); border-left: 1px solid var(--border); margin-left: -1px; }
  dd { margin: 0; font-family: var(--display); font-size: clamp(18px, calc(19cqi / var(--n)), 42px); font-weight: 700; letter-spacing: -0.03em; line-height: 1; color: var(--accent); white-space: nowrap; }
  dt { font-size: clamp(11.5px, 3.4cqi, 13.5px); line-height: 1.4; color: var(--text-2); overflow-wrap: anywhere; hyphens: auto; }
</style>
