---
// Impact numbers ("6 / plugins on Fab"), read at a glance: the first thing a
// hiring team scans for.
import type { WorkStat } from '../../../content/repository.ts';

interface Props {
  stats: WorkStat[];
}
const { stats } = Astro.props;
---

<dl class="stats" style={`--n: ${Math.min(stats.length, 4)}`}>
  {
    stats.map((s) => (
      <div>
        <dt>{s.label}</dt>
        <dd>{s.value}</dd>
      </div>
    ))
  }
</dl>

<style>
  .stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 180px), 1fr));
    margin: 0;
    border: 1px solid var(--border);
    border-radius: var(--r-lg);
    background: var(--surface);
    overflow: hidden;
  }
  @media (min-width: 900px) { .stats { grid-template-columns: repeat(var(--n), minmax(0, 1fr)); } }
  .stats div { display: flex; flex-direction: column-reverse; justify-content: flex-end; gap: 6px; padding: 22px 24px; border-left: 1px solid var(--border); margin-left: -1px; }
  dd { margin: 0; font-family: var(--display); font-size: clamp(30px, 4vw, 42px); font-weight: 700; letter-spacing: -0.03em; line-height: 1; color: var(--accent); }
  dt { font-size: 13.5px; line-height: 1.45; color: var(--text-2); }
</style>
