---
// /work/<slug>: one project, laid out the way a recruiter reads it.
//
// 1. What it is: kind, title, one-line pitch, and the buttons (reel, repo...).
// 2. Proof: the reel (or cover) beside an "at a glance" panel with the role,
//    timeline, team, engine, tech and key results.
// 3. The write-up from the Markdown body: problem, approach, systems, results.
// 4. The previous and next project, and how to get in touch.
import Base from '../../layouts/Base.astro';
import Icon from '../Icon.astro';
import Prose from '../Prose.astro';
import ContactSection from '../ContactSection.astro';
import ProjectLinks from './ProjectLinks.astro';
import TechTags from './TechTags.astro';
import { image } from '../../content/media.ts';
import { render, youtubeFacade } from '../../content/markdown.ts';
import { content, type CaseStudy } from '../../content/repository.ts';

interface Props {
  study: CaseStudy;
}
const { study } = Astro.props;
const work = content().work;
const index = work.indexOf(study);
const previous = index > 0 ? work[index - 1] : undefined;
const next = work[index + 1];
const rendered = await render(study.body, { sourcePath: study.assetPath });
const cover = !study.reel && study.cover ? await image(study.cover, 840) : null;
const facts = [
  ['Role', study.role],
  ['Timeline', study.period],
  ['Team', study.team],
  ['Engine', study.engine],
].filter((f): f is [string, string] => !!f[1]);
const glance = facts.length > 0 || study.tech.length > 0 || study.highlights.length > 0;
---

<Base title={study.title} description={study.tagline}>
  <section class="container study">
    <a class="button button-text back" href="/work"><Icon name="arrow-left" />All work</a>
    <span class="eyebrow">{study.workKind}{study.draft && ' · Draft'}</span>
    <h1 class="display-sm fluid">{study.title}</h1>
    {study.tagline && <p class="tagline">{study.tagline}</p>}
    {Object.keys(study.links).length > 0 && <ProjectLinks links={study.links} />}

    <div class:list={['proof', { 'with-glance': glance && (study.reel || cover) }]}>
      {study.reel && <Fragment set:html={youtubeFacade(study.reel.videoId, study.reel.start, study.title)} />}
      {cover && (
        <img class="cover" src={cover.src} srcset={cover.srcset} sizes="(max-width: 1099px) 100vw, 840px" width={cover.width} height={cover.height} alt="" fetchpriority="high" />
      )}
      {
        glance && (
          <aside class="glance">
            {facts.length > 0 && (
              <dl>
                {facts.map(([name, value]) => (
                  <div>
                    <dt class="label-sm">{name}</dt>
                    <dd>{value}</dd>
                  </div>
                ))}
              </dl>
            )}
            {study.tech.length > 0 && (
              <div>
                <span class="label-sm">Tech</span>
                <TechTags tech={study.tech} />
              </div>
            )}
            {study.highlights.length > 0 && (
              <div>
                <span class="label-sm">Highlights</span>
                <ul>
                  {study.highlights.map((h) => (
                    <li>
                      <Icon name="check-circle" />
                      <span>{h}</span>
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </aside>
        )
      }
    </div>
  </section>

  <div class="container reading body">
    <Prose rendered={rendered} />
    {
      (previous || next) && (
        <nav class="pager" aria-label="More projects">
          {previous ? (
            <a class="card" href={previous.route}>
              <span class="label-sm">Previous project</span>
              <span class="title">{previous.title}</span>
            </a>
          ) : (
            <span />
          )}
          {next && (
            <a class="card end" href={next.route}>
              <span class="label-sm">Next project</span>
              <span class="title">{next.title}</span>
            </a>
          )}
        </nav>
      )
    }
  </div>
  <ContactSection />
</Base>

<style>
  .study { display: grid; justify-items: start; gap: 8px; padding-top: 32px; }
  .back { margin: 0 0 16px -12px; }
  .tagline { max-width: 760px; margin-top: 8px; font-size: 19px; line-height: 1.7; }
  .study > :global(.button-row) { margin-top: 16px; }
  .proof { display: grid; gap: 24px; width: 100%; margin-top: 24px; }
  .proof :global(.youtube) { margin: 0; }
  @media (min-width: 1100px) { .proof.with-glance { grid-template-columns: 1fr 360px; align-items: start; } }
  .cover { width: 100%; aspect-ratio: 16 / 9; object-fit: cover; border-radius: var(--r-md); border: 1px solid var(--border); }
  .glance { display: grid; gap: 24px; padding: 24px; border: 1px solid var(--border); border-radius: var(--r-lg); background: var(--surface); }
  .glance > div { display: grid; gap: 8px; }
  dl { display: flex; flex-wrap: wrap; gap: 16px 32px; margin: 0; }
  dl div { min-width: 130px; max-width: 300px; }
  dt { margin-bottom: 6px; }
  dd { margin: 0; font-size: 14.5px; color: var(--text); }
  ul { display: grid; gap: 8px; margin: 0; padding: 0; list-style: none; }
  li { display: flex; gap: 8px; font-size: 14.5px; color: var(--text); }
  li :global(.icon) { margin-top: 3px; color: var(--accent); font-size: 17px; }
  .body { padding-top: 48px; }
  .pager { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-top: 48px; }
  .pager .card { display: grid; gap: 4px; padding: 18px; }
  .pager .end { text-align: right; justify-items: end; }
  .pager .title { font-size: 16px; font-weight: 600; color: var(--accent); }
</style>
