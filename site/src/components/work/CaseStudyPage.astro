---
// /work/<slug>: one Work entry, laid out the way a hiring team reads it.
//
// 1. What it is: kind, name, role / where / when, the summary and the links.
// 2. Proof: the reel, clip or picture beside "At a glance" (role, company,
//    timeline, team, engine, tech, key results).
// 3. The widgets the entry has, each optional: impact numbers, "What I built"
//    feature tiles, code spotlight, milestones and a quote.
// 4. The write-up from the Markdown body, if there is one.
// 5. The previous and next entry, and how to get in touch.
import Base from '../../layouts/Base.astro';
import Icon from '../Icon.astro';
import Prose from '../Prose.astro';
import ContactSection from '../ContactSection.astro';
import ProjectLinks from './ProjectLinks.astro';
import TechTags from './TechTags.astro';
import WorkMedia from './WorkMedia.astro';
import Stats from './widgets/Stats.astro';
import Features from './widgets/Features.astro';
import CodeSpotlight from './widgets/CodeSpotlight.astro';
import Milestones from './widgets/Milestones.astro';
import Quote from './widgets/Quote.astro';
import WidgetTitle from './widgets/WidgetTitle.astro';
import { render, youtubeFacade } from '../../content/markdown.ts';
import { content, type CaseStudy } from '../../content/repository.ts';
import type { IconName } from '../../config.ts';

interface Props {
  study: CaseStudy;
}
const { study } = Astro.props;
const work = content().work;
const index = work.indexOf(study);
const previous = index > 0 ? work[index - 1] : undefined;
const next = work[index + 1];
const rendered = study.body.trim() ? await render(study.body, { sourcePath: study.assetPath }) : null;

const where = [study.company && study.company !== study.title ? study.company : undefined, study.location].filter(Boolean).join(' · ');
const byline: [IconName, string][] = (
  [
    ['work', study.role],
    ['map-pin', where],
    ['calendar', study.period],
  ] as [IconName, string | undefined][]
).filter((b): b is [IconName, string] => !!b[1]);
const facts = [
  ['Role', study.role],
  ['Company', study.company],
  ['Location', study.location],
  ['Timeline', study.period],
  ['Team', study.team],
  ['Engine', study.engine],
].filter((f): f is [string, string] => !!f[1]);
const glance = facts.length > 0 || study.tech.length > 0 || study.highlights.length > 0;
const side = study.timeline.length > 0 && !!study.quote;
---

<Base title={study.title} description={study.summary}>
  <section class="container study">
    <a class="button button-outlined back" href="/work"><Icon name="arrow-left" />All work</a>
    <span class="eyebrow">{study.workKind}{study.draft && ' · Draft'}</span>
    <h1 class="display-sm fluid">{study.title}</h1>
    {
      byline.length > 0 && (
        <ul class="byline">
          {byline.map(([icon, text]) => (
            <li>
              <Icon name={icon} />
              {text}
            </li>
          ))}
        </ul>
      )
    }
    {study.summary && <p class="summary">{study.summary}</p>}
    {Object.keys(study.links).length > 0 && <ProjectLinks links={study.links} />}

    <div class:list={['proof', { 'with-glance': glance }]}>
      <div class="proof-media">
        {study.reel ? <Fragment set:html={youtubeFacade(study.reel.videoId, study.reel.start, study.title)} /> : <WorkMedia study={study} width={840} eager />}
      </div>
      {
        glance && (
          <aside class="glance">
            <span class="eyebrow">At a glance</span>
            {facts.length > 0 && (
              <dl>
                {facts.map(([name, value]) => (
                  <div>
                    <dt class="label-sm">{name}</dt>
                    <dd>{value}</dd>
                  </div>
                ))}
              </dl>
            )}
            {study.tech.length > 0 && (
              <div>
                <span class="label-sm">Tech</span>
                <TechTags tech={study.tech} />
              </div>
            )}
            {study.highlights.length > 0 && (
              <div>
                <span class="label-sm">Key results</span>
                <ul class="results">
                  {study.highlights.map((h) => (
                    <li>
                      <Icon name="check-circle" />
                      <span>{h}</span>
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </aside>
        )
      }
    </div>
  </section>

  <div class="container widgets">
    {study.stats.length > 0 && <Stats stats={study.stats} />}
    {study.features.length > 0 && <Features features={study.features} sourcePath={study.assetPath} />}
    {study.code.length > 0 && <CodeSpotlight code={study.code} sourcePath={study.assetPath} />}
    {
      (study.timeline.length > 0 || study.quote) && (
        <div class:list={['story', { side }]}>
          {study.timeline.length > 0 && <Milestones timeline={study.timeline} />}
          {study.quote && (
            <section>
              {!side && <WidgetTitle eyebrow="In their words" title="What they said" />}
              <Quote quote={study.quote} />
            </section>
          )}
        </div>
      )
    }
  </div>

  <div class="container reading body">
    {
      rendered && (
        <>
          <WidgetTitle eyebrow="Deep dive" title="How it was built" />
          <Prose rendered={rendered} />
        </>
      )
    }
    {
      (previous || next) && (
        <nav class="pager" aria-label="More work">
          {previous ? (
            <a class="card" href={previous.route}>
              <span class="label-sm">Previous</span>
              <span class="title">{previous.title}</span>
            </a>
          ) : (
            <span />
          )}
          {next && (
            <a class="card end" href={next.route}>
              <span class="label-sm">Next</span>
              <span class="title">{next.title}</span>
            </a>
          )}
        </nav>
      )
    }
  </div>
  <ContactSection />
</Base>

<style>
  .study { display: grid; justify-items: start; gap: 8px; padding-top: 32px; }
  .back { min-height: 38px; padding: 0 14px 0 10px; margin-bottom: 16px; font-size: 13.5px; }
  .byline { display: flex; flex-wrap: wrap; gap: 8px 22px; margin: 10px 0 0; padding: 0; list-style: none; }
  .byline li { display: inline-flex; align-items: center; gap: 8px; font-size: 14.5px; color: var(--text-2); }
  .byline :global(.icon) { color: var(--accent); font-size: 16px; }
  .summary { max-width: 780px; margin-top: 14px; font-size: 18px; line-height: 1.7; }
  .study > :global(.button-row) { margin-top: 18px; }

  .proof { display: grid; gap: 24px; width: 100%; margin-top: 36px; }
  @media (min-width: 1100px) { .proof.with-glance { grid-template-columns: minmax(0, 1fr) 360px; align-items: start; } }
  .proof-media { position: relative; aspect-ratio: 16 / 9; overflow: hidden; border: 1px solid var(--border); border-radius: var(--r-md); background: #000; }
  .proof-media :global(.youtube) { margin: 0; height: 100%; border-radius: 0; }
  .glance { display: grid; gap: 22px; padding: 24px; border: 1px solid var(--border); border-radius: var(--r-lg); background: var(--surface); }
  .glance > div { display: grid; gap: 8px; }
  dl { display: grid; grid-template-columns: repeat(auto-fill, minmax(140px, 1fr)); gap: 16px 24px; margin: 0; }
  dt { margin-bottom: 4px; }
  dd { margin: 0; font-size: 14.5px; color: var(--text); }
  .results { display: grid; gap: 8px; margin: 0; padding: 0; list-style: none; }
  .results li { display: flex; gap: 8px; font-size: 14.5px; color: var(--text); }
  .results :global(.icon) { margin-top: 3px; color: var(--accent); font-size: 17px; }

  .widgets { display: grid; gap: 72px; padding-top: 56px; }
  .widgets:empty { display: none; }
  .story { display: grid; gap: 72px; }
  @media (min-width: 1000px) { .story.side { grid-template-columns: minmax(0, 6fr) minmax(0, 5fr); gap: 56px; align-items: center; } }

  .body { padding-top: 72px; }
  .pager { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-top: 56px; }
  .pager .card { display: grid; gap: 4px; padding: 18px; }
  .pager .end { text-align: right; justify-items: end; }
  .pager .title { font-size: 16px; font-weight: 600; color: var(--accent); }
</style>
