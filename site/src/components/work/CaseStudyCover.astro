---
// The cover image; without one, the reel's YouTube thumbnail; else a plain gradient.
import { image } from '../../content/media.ts';
import type { CaseStudy } from '../../content/repository.ts';

interface Props {
  study: CaseStudy;
  width?: number;
}
const { study, width = 420 } = Astro.props;
const info = study.cover
  ? await image(study.cover, width)
  : study.reel
    ? { src: `https://i.ytimg.com/vi/${study.reel.videoId}/hqdefault.jpg`, width: 480, height: 360 }
    : null;
---

{
  info ? (
    <img class="cover" src={info.src} srcset={(info as { srcset?: string }).srcset} sizes={`(max-width: 719px) 100vw, ${width}px`} width={info.width} height={info.height} alt="" loading="lazy" decoding="async" />
  ) : (
    <div class="cover placeholder" />
  )
}

<style>
  .cover { width: 100%; height: 100%; object-fit: cover; }
  .placeholder { background: radial-gradient(140% 140% at 20% 10%, var(--hero-glow), #0b0b0e); }
</style>
