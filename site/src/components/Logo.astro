---
import { site } from '../config.ts';
---

<a class="logo" href="/" aria-label={`${site.name} home`}>
  <img src={site.logo} alt="" width="30" height="30" />
  <span>{site.name.toUpperCase()}</span>
</a>

<style>
  .logo { display: inline-flex; align-items: center; gap: 10px; padding: 6px 4px; border-radius: var(--r-sm); flex: none; }
  .logo span { font-family: var(--display); font-size: 17px; font-weight: 700; letter-spacing: 0.16em; color: var(--text); }
</style>
