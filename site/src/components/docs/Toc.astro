---
// "On this page": the h2/h3 headings, highlighting the one being read.
import type { Heading } from '../../content/markdown.ts';

interface Props {
  headings: Heading[];
}
const { headings } = Astro.props;
---

<nav class="toc" aria-label="On this page">
  <span class="label-sm">On this page</span>
  <ul>
    {
      headings.map((h, i) => (
        <li class:list={[`level-${h.level}`]}>
          <a href={`#${h.id}`} aria-current={i === 0 ? 'true' : undefined}>{h.text}</a>
        </li>
      ))
    }
  </ul>
</nav>

<script>
  // A heading counts as "being read" once it's in the top 30% of the window.
  // An IntersectionObserver tells when that changes: nothing runs per scroll frame.
  import { observe, onPage } from '../../scripts/lifecycle.ts';

  onPage((signal) => {
    const links = [...document.querySelectorAll<HTMLAnchorElement>('.toc a')];
    if (links.length === 0) return;
    const targets = links.map((a) => document.getElementById(decodeURIComponent(a.hash.slice(1)))).filter((h): h is HTMLElement => !!h);
    const passed = new Set<Element>();
    const mark = (id: string) => links.forEach((a) => a.toggleAttribute('aria-current', a.hash === `#${id}`));
    const update = () => {
      const atEnd = innerHeight + scrollY >= document.documentElement.scrollHeight - 4;
      const current = atEnd ? targets.at(-1) : (targets.filter((t) => passed.has(t)).at(-1) ?? targets[0]);
      if (current) mark(current.id);
    };
    observe(
      signal,
      targets,
      (entries) => {
        for (const e of entries) {
          if (e.boundingClientRect.top < (e.rootBounds?.top ?? 0) + 1 || e.isIntersecting) passed.add(e.target);
          else passed.delete(e.target);
        }
        update();
      },
      { rootMargin: '0px 0px -70% 0px' },
    );
    addEventListener('scrollend', update, { passive: true, signal });
    // A clicked heading stays highlighted while the page scrolls to it.
    for (const a of links) a.addEventListener('click', () => mark(decodeURIComponent(a.hash.slice(1))), { signal });
  });
</script>

<style>
  .toc {
    display: none;
    position: sticky;
    top: var(--nav-h);
    align-self: start;
    max-height: calc(100dvh - var(--nav-h));
    overflow-y: auto;
    padding: 48px 24px 48px 8px;
  }
  @media (min-width: 1280px) { .toc { display: block; } }
  .label-sm { padding-left: 14px; margin-bottom: 16px; }
  ul { margin: 0; padding: 0; list-style: none; }
  a {
    display: block;
    padding: 6px 4px 6px 14px;
    border-left: 2px solid var(--border);
    color: var(--text-2);
    font-size: 13.5px;
    line-height: 1.45;
    transition: color var(--fast), border-color var(--fast);
  }
  .level-3 a { padding-left: 26px; }
  a:hover { color: var(--text); }
  a[aria-current] { color: var(--accent); border-left-color: var(--accent); font-weight: 600; }
</style>
