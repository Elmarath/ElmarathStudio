---
import { image } from '../../content/media.ts';
import type { DocCategory } from '../../content/repository.ts';
import Icon from '../Icon.astro';

interface Props {
  category: DocCategory;
  size: number;
}
const { category, size } = Astro.props;
const info = category.thumbnail ? await image(category.thumbnail, size) : null;
---

<div class="thumb zoom-media" style={`--size: ${size}px`}>
  {info ? <img src={info.src} alt="" width={size} height={size} loading="lazy" decoding="async" /> : <Icon name="puzzle" />}
</div>

<style>
  .thumb { width: var(--size); height: var(--size); flex: none; display: grid; place-items: center; border-radius: calc(var(--size) * 0.14); background: var(--surface-raised); color: var(--text-3); font-size: calc(var(--size) * 0.4); }
  img { width: 100%; height: 100%; object-fit: cover; }
</style>
