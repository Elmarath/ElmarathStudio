---
// One folder of the docs sidebar, and the folders inside it.
import { allPages, containsRoute, type DocCategory } from '../../content/repository.ts';
import { image } from '../../content/media.ts';
import Icon from '../Icon.astro';

interface Props {
  node: DocCategory;
  depth: number;
  path: string;
}
const { node, depth, path } = Astro.props;
const active = containsRoute(node, path);
const thumb = depth === 0 && node.thumbnail ? await image(node.thumbnail, 22) : null;
const first = allPages(node)[0]?.route ?? node.route;
const indent = (d: number) => `--indent: ${12 + d * 12 + (d > 0 ? 8 : 0)}px`;
---

<details open={active} data-first={first} data-active={active ? '' : undefined}>
  <summary class:list={['folder', { top: depth === 0, active }]} style={`--indent: ${12 + depth * 12}px`}>
    {thumb && <img src={thumb.src} alt="" width="22" height="22" loading="lazy" decoding="async" />}
    <span>{node.label}</span>
    <Icon name="chevron-right" />
  </summary>
  <div class="children">
    {
      node.indexPage && (
        <a class="link" style={indent(depth + 1)} href={node.route} aria-current={path === node.route ? 'page' : undefined}>
          Overview
        </a>
      )
    }
    {
      node.children.map((child) =>
        child.kind === 'page' ? (
          <a class="link" style={indent(depth + 1)} href={child.route} aria-current={path === child.route ? 'page' : undefined}>
            {child.label}
          </a>
        ) : (
          <Astro.self node={child} depth={depth + 1} path={path} />
        ),
      )
    }
  </div>
</details>

<style>
  summary {
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: 40px;
    padding: 8px 8px 8px var(--indent);
    border-radius: var(--r-sm);
    color: var(--text-2);
    font-size: 14.5px;
    font-weight: 600;
    line-height: 1.35;
    cursor: pointer;
    list-style: none;
    transition: background-color var(--fast), color var(--fast);
  }
  summary::-webkit-details-marker { display: none; }
  summary:hover { background: color-mix(in srgb, var(--text) 5%, transparent); color: var(--text); }
  summary.top { color: var(--text); font-size: 14px; font-weight: 700; }
  summary.active { color: var(--text); }
  summary span { flex: 1; }
  summary img { width: 22px; height: 22px; border-radius: 5px; object-fit: cover; }
  summary :global(.icon) { color: var(--text-3); font-size: 16px; transition: transform var(--fast); }
  details[open] > summary :global(.icon) { transform: rotate(90deg); }
  .children { display: grid; gap: 2px; padding: 2px 0; }
</style>
